<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\quicktext.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Shown in the file properties of QuickText.exe -->
  <PropertyGroup>
    <Version>2.0.2</Version>
    <Product>QuickText</Product>
    <Authors>BlazeR</Authors>
    <Company>BlazeR</Company>
    <Description>A small, fast scratchpad for Windows</Description>
    <Copyright>Copyright (c) 2026 BlazeR</Copyright>
    <RepositoryUrl>https://github.com/BlazeR-28/QuickText</RepositoryUrl>
  </PropertyGroup>

  <!-- Release: one exe that runs without installing anything.
       Pass -p:SelfContained=false for the tiny variant that needs the .NET Desktop Runtime. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression would shrink the exe from ~120 MB to ~57 MB but decompresses all assemblies into private RAM (+60 MB). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <EmbeddedResource Include="Resources\Markdown.xshd" />
    <Resource Include="Resources\quicktext.ico" />
  </ItemGroup>

</Project>
