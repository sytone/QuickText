<Window x:Class="QuickText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuickText" Icon="Resources/quicktext.ico"
        Width="520" Height="280" MinWidth="360" MinHeight="180"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style x:Key="NotePickerStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                        <Setter Property="Background" Value="{StaticResource Surface1}"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface3}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource Surface1}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Grid Margin="6,0">
                                                <TextBlock Text="&#xE70D;" FontSize="10"
                                                           FontFamily="{StaticResource IconFont}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Margin="8,0,24,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource Surface1}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,0" ToolTip="Double-click the title bar to collapse or expand">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center" Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="NewBtn" Style="{StaticResource IconButton}" Content="&#xE8A5;"
                        ToolTip="New note" AutomationProperties.Name="New note"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <ComboBox x:Name="NotePicker" Grid.Column="1" Margin="6,0" MinWidth="0"
                          Style="{StaticResource NotePickerStyle}"
                          VerticalContentAlignment="Center" FontSize="11"
                          ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                          AutomationProperties.Name="Current note"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="DeleteBtn" Grid.Column="2" Style="{StaticResource IconButton}"
                        Content="&#xE74D;" ToolTip="Delete selected note"
                        AutomationProperties.Name="Delete selected note"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
            <TextBlock x:Name="TitleLabel" Grid.Column="1" Text="QuickText" Margin="8,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" FontWeight="SemiBold" IsHitTestVisible="False"
                       Foreground="{StaticResource FgSoftBrush}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SettingsBtn" Style="{StaticResource IconButton}"
                        Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="CopyBtn" Style="{StaticResource IconButton}"
                        ToolTip="Copy the whole note" AutomationProperties.Name="Copy note"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 7,7 L 7,3 L 16,3 L 20,7 L 20,18 L 17,18 M 16,3 L 16,7 L 20,7 M 3,8 L 12,8 L 16,12 L 16,22 L 3,22 Z M 12,8 L 12,12 L 16,12 M 6,15 L 12,15 M 6,18 L 12,18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Content="&#xE711;"
                        AutomationProperties.Name="Hide window" Margin="2,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <!-- Editor -->
        <Grid x:Name="EditorPanel" Grid.Row="1" Margin="0,0,6,0">
            <TextBox x:Name="Pad" Style="{StaticResource PadStyle}"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource FgBrush}"
                     CaretBrush="{StaticResource AccentBrush}"
                     SelectionBrush="{StaticResource AccentBrush}" SelectionOpacity="0.35"
                     IsInactiveSelectionHighlightEnabled="True"
                     FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                     SpellCheck.IsEnabled="True" Padding="8,2,8,4"
                     TextBlock.LineHeight="21" TextBlock.LineStackingStrategy="BlockLineHeight"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            <!-- Empty-note placeholder doubles as the "how do I get this window back" hint -->
            <StackPanel Margin="23,2,8,0" IsHitTestVisible="False" VerticalAlignment="Top">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text.Length, ElementName=Pad}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Same line height as the editor, so the text is centered on the caret -->
                <TextBlock Text="Start typing..." FontSize="14" Foreground="{StaticResource FaintBrush}"
                           LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
                <TextBlock x:Name="HintLabel" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Grid>

        <WrapPanel x:Name="PillPanel" Grid.Row="2" Margin="18,6,16,10"/>

        <!-- Settings overlay -->
        <Grid x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{StaticResource PanelBrush}" Focusable="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,6,22,18">

                    <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource FgBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Autosave and restore" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                            <TextBlock Text="Keeps your note after closing the app" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutosaveSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                            <TextBlock Text="Runs quietly in the tray after you sign in" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Opacity" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                        <TextBlock x:Name="OpacityLabel" Text="100%" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Margin="0,0,0,18"/>

                    <TextBlock Text="SHORTCUTS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Copy note" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                        <Button x:Name="CopyKeyBtn" Tag="Copy" Style="{StaticResource HotkeyButton}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Hide window" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                        <Button x:Name="CloseKeyBtn" Tag="Close" Style="{StaticResource HotkeyButton}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Exit QuickText" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                        <Button x:Name="ExitKeyBtn" Tag="Exit" Style="{StaticResource HotkeyButton}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Show / hide from anywhere" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                            <TextBlock Text="Works in every app. Left-click on the tray icon does the same." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="GlobalKeyBtn" Tag="Global" Style="{StaticResource HotkeyButton}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock x:Name="HotkeyError" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"/>
                    <TextBlock Text="Click a field, then press the keys. Backspace clears it."
                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18"/>

                    <Grid>
                        <Button x:Name="ExitAppBtn" Style="{StaticResource DangerButton}" Content="Exit QuickText"
                                HorizontalAlignment="Left"/>
                        <Button x:Name="DoneBtn" Style="{StaticResource PrimaryButton}" Content="Done"
                                HorizontalAlignment="Right" MinWidth="80"/>
                    </Grid>
                    <TextBlock x:Name="AboutLabel" FontSize="10" Foreground="{StaticResource FaintBrush}"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
