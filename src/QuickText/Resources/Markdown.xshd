<?xml version="1.0"?>
<SyntaxDefinition name="QuickText Markdown" extensions=".md"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Heading" foreground="#E2AD3B" fontWeight="bold"/>
  <Color name="Code" foreground="#9BC27A"/>
  <Color name="Link" foreground="#8DCAD4"/>
  <Color name="Marker" foreground="#C9C3B4"/>
  <Color name="Quote" foreground="#8F897C"/>
  <Color name="Strong" fontWeight="bold"/>
  <Color name="Emphasis" fontStyle="italic"/>
  <RuleSet>
    <Span color="Code" multiline="true">
      <Begin>^[ ]{0,3}`{3,}.*$</Begin>
      <End>^[ ]{0,3}`{3,}\s*$</End>
    </Span>
    <Span color="Code" multiline="true">
      <Begin>^[ ]{0,3}~{3,}.*$</Begin>
      <End>^[ ]{0,3}~{3,}\s*$</End>
    </Span>
    <Span color="Code">
      <Begin>`+</Begin>
      <End>`+</End>
    </Span>
    <Rule color="Heading">^[ ]{0,3}\#{1,6}(?:[ \t]+.*|$)</Rule>
    <Rule color="Heading">^[ ]{0,3}(?:=+|-+)[ \t]*$</Rule>
    <Rule color="Quote">^[ ]{0,3}&gt;.*$</Rule>
    <Rule color="Marker">^[ \t]*(?:[-+*]|\d+[.)])[ \t]+(?:\[[ xX]\][ \t]+)?</Rule>
    <Rule color="Link">!?\[[^\]\r\n]*\]\([^)\r\n]*\)</Rule>
    <Rule color="Link">https?://[^\s&lt;&gt;]+</Rule>
    <Rule color="Strong">\*\*[^*\r\n]+\*\*|__[^_\r\n]+__</Rule>
    <Rule color="Emphasis">(?&lt;!\*)\*[^*\r\n]+\*(?!\*)|(?&lt;!\w)_[^_\r\n]+_(?!\w)</Rule>
  </RuleSet>
</SyntaxDefinition>
